# Copy to /opt/xmas/.env on the VPS (mode 600) and fill in. Never commit .env.

# Secrets: generate fresh values. ANON_KEY and SERVICE_ROLE_KEY are HS256 JWTs
# signed with JWT_SECRET carrying {"iss":"supabase","role":"anon"} and
# {"iss":"supabase","role":"service_role"}; tool/deploy_vps.sh --init makes them.
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=

# Database (inside the compose network)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
JWT_EXPIRY=3600

# Public URLs
API_EXTERNAL_URL=https://xmas-api.2524.info
SITE_URL=https://xmas.2524.info
ADDITIONAL_REDIRECT_URLS=https://xmas.2524.info/#/reset

# Auth
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# Email (password reset). Leave the host invalid until an SMTP provider exists.
SMTP_ADMIN_EMAIL=noreply@2524.info
SMTP_HOST=smtp.invalid
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Christmas Planner
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# PostgREST
PGRST_DB_SCHEMAS=public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
